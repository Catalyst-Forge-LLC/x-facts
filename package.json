{
  "name": "@xfacts/panel",
  "version": "0.1.1",
  "type": "module",
  "description": "xFacts hub and Panel tooling: derived tool-surface views and drift checks.",
  "license": "MIT",
  "scripts": {
    "panel": "node bin/xfacts-panel.mjs panel",
    "validate": "node bin/xfacts-panel.mjs validate",
    "integrity": "node bin/xfacts-panel.mjs integrity",
    "drift": "node bin/xfacts-panel.mjs drift",
    "encode": "node bin/xfacts-panel.mjs encode",
    "badge": "node bin/xfacts-panel.mjs badge",
    "build": "node scripts/build.mjs src/cli.ts",
    "prepack": "pnpm build",
    "test": "tsx --test src/*.test.ts",
    "typecheck": "tsc --noEmit",
    "ship": "wrangler deploy --config site/wrangler.jsonc"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "canonicalize": "^2.1.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "wrangler": "^4.28.0"
  },
  "pnpm": {
    "overrides": {
      "sharp": "0.35.4"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  },
  "bin": {
    "xfacts-panel": "./bin/xfacts-panel.mjs"
  },
  "files": [
    "bin",
    "dist",
    "specs/enums.json",
    "specs/severity.json",
    "specs/panel.schema.json",
    "specs/profiles/mcp-tools-list/mapping.json",
    "specs/profiles/tool-facts/mapping.json",
    "LICENSE",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Catalyst-Forge-LLC/x-facts.git"
  },
  "publishConfig": {
    "access": "public"
  }
}
